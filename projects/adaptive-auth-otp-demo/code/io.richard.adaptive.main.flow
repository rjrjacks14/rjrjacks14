Flow io.richard.adaptive.main
     Basepath ""
creds = RRF "login.ftlh" 
When creds.password is "Passw0rd!"
     riskLevel = "LOW"
     When riskLevel is "LOW"
          it_jimqx = {success:true, data: { userId: "as9233Qz", property1: "value1"}}
          Finish it_jimqx
     Otherwise
          otp = RRF "otp.ftlh" 
          When otp.code is 123456
               it_veoeb = {success:true, data: { userId: "as9233Qz", property1: "value1"}}
               Finish it_veoeb
          Otherwise
               // Invalid OTP
               it_pbjlh = {success:false, error: "Your error message here"}
               Finish it_pbjlh
Otherwise
     // Wrong Password
     it_jcbrv = {success:false, error: "Your error message here"}
     Finish it_jcbrv